#!/usr/bin/env bash
# Composite a semi-transparent Catppuccin Macchiato gradient over wallpaper(s).
# Keeps your images — only the displayed wallpaper gets the overlay.
set -euo pipefail

CACHE="$HOME/.cache/wallpaper-overlay"
STATE="$CACHE/originals"
GETTER="$CACHE/wallpaper-path"
OPACITY="${WALLPAPER_OVERLAY_OPACITY:-0.42}"

usage() {
  cat <<EOF
usage: wallpaper-overlay [--opacity 0.42] [--refresh] [--reset] [image ...]

  (no args)   overlay saved originals, or detect current wallpaper(s)
  --refresh   forget saved originals and re-detect from the desktop
  --reset     restore originals (no overlay)
  image ...   overlay these files instead of auto-detect

env: WALLPAPER_OVERLAY_OPACITY (default 0.42)
EOF
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing: $1 (brew install $2)" >&2
    exit 1
  }
}

build_getter() {
  mkdir -p "$CACHE"
  cat >"$CACHE/wallpaper-path.swift" <<'SWIFT'
import AppKit
for s in NSScreen.screens {
  if let u = NSWorkspace.shared.desktopImageURL(for: s) {
    print(u.path)
  }
}
SWIFT
  swiftc -O "$CACHE/wallpaper-path.swift" -o "$GETTER"
}

wallpaper_paths() {
  [ -x "$GETTER" ] || build_getter
  "$GETTER"
}

overlay_one() {
  local src="$1" idx="$2" out="$CACHE/display-${idx}.jpg"
  local w h
  w="$(magick identify -format '%w' "$src")"
  h="$(magick identify -format '%h' "$src")"
  local alpha
  alpha="$(python3 -c "print(format(int(float('$OPACITY') * 255), '02X'))")"
  magick "$src" \
    \( -size "${w}x${h}" gradient:"#1e2030${alpha}-#18192600" \) \
    -compose Over -composite \
    -quality 95 "$out"
  echo "$out"
}

apply_wallpaper() {
  local path="$1"
  osascript -e "tell application \"Finder\" to set desktop picture to POSIX file \"$path\""
}

refresh=0
reset=0
sources=()

while [ $# -gt 0 ]; do
  case "$1" in
  -h | --help) usage; exit 0 ;;
  --opacity)
    OPACITY="${2:?}"
    shift 2
    ;;
  --refresh)
    refresh=1
    shift
    ;;
  --reset)
    reset=1
    shift
    ;;
  --) shift; break ;;
  -*) echo "unknown option: $1" >&2; usage; exit 1 ;;
  *) sources+=("$1"); shift ;;
  esac
done
sources+=("$@")

need magick imagemagick
need swiftc swift

if [ "$reset" = 1 ]; then
  if [ ! -d "$STATE" ] || [ -z "$(ls -A "$STATE" 2>/dev/null)" ]; then
    echo "no saved originals — nothing to reset"
    exit 0
  fi
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    apply_wallpaper "$f"
  done < <(cat "$STATE"/* 2>/dev/null | sort -u)
  echo "restored original wallpaper(s)"
  exit 0
fi

if [ "$refresh" = 1 ]; then
  rm -rf "$STATE"
fi

mkdir -p "$STATE" "$CACHE"

if [ ${#sources[@]} -eq 0 ]; then
  detected=()
  while IFS= read -r line; do
    [ -n "$line" ] && detected+=("$line")
  done < <(wallpaper_paths)
  if [ ${#detected[@]} -eq 0 ]; then
    echo "could not detect wallpaper — pass image path(s)" >&2
    exit 1
  fi
  idx=0
  for src in "${detected[@]}"; do
    if [ ! -f "$STATE/$idx" ] || [ "$refresh" = 1 ]; then
      printf '%s' "$src" >"$STATE/$idx"
    fi
    sources+=("$(cat "$STATE/$idx")")
    idx=$((idx + 1))
  done
fi

idx=0
for src in "${sources[@]}"; do
  [ -f "$src" ] || {
    echo "not found: $src" >&2
    exit 1
  }
  if [ ! -f "$STATE/$idx" ]; then
    printf '%s' "$src" >"$STATE/$idx"
  fi
  out="$(overlay_one "$src" "$idx")"
  apply_wallpaper "$out"
  idx=$((idx + 1))
done

echo "wallpaper overlay applied (opacity=$OPACITY). run with --reset to undo."
